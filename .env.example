# Copy this file to .env.local and adjust the values for your machine.
# .env.local is ignored by git; never commit real values.
#
# Both variables are required and case-sensitive. They are independent of
# NODE_ENV. See docs/wiki/frontend-bff-proxy.md for the full contract.

# Where the frontend runs: local | e2e | staging | prod
APP_ENV=local

# Backend origin only. No path, query, fragment, or credentials.
# staging and prod require https.
BACKEND_URL=http://127.0.0.1:8080
